# Temporal - Workflow orchestration platform
# Copy to app.env and customize

# Timezone
TZ=America/New_York

# Hostname
BASE_HOST_NAME=$HOSTNAME

# Database (PostgreSQL)
DB_CREATE_DATABASE_NAME=temporal
DB_USER_NAME=temporal
DB_USER_PASS=changeme_db_password
DB_PORT=5432

# Temporal config
TEMPORAL_DB=postgres12
TEMPORAL_NAMESPACE=default
TEMPORAL_NAMESPACE_RETENTION=24h
LOG_LEVEL=info
